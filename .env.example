# Copy to .env.local and fill in. .env*.local is git-ignored. Keys never go to the browser.

# Which provider /api/ai uses: claude | openrouter
AI_PROVIDER=claude

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Web search: provider (Claude web search / OpenRouter web plugin) | tavily | off
AI_SEARCH=provider
# Only for AI_SEARCH=tavily
TAVILY_API_KEY=

# Model per tier. Defaults shown; override only if needed.
# small = classify / extract / rewrite / short labels. large = reasoning / main results.
# CLAUDE_MODEL_SMALL=claude-haiku-5-5
# CLAUDE_MODEL_LARGE=claude-opus-5-5
# OPENROUTER_MODEL_SMALL=anthropic/claude-haiku-5.5
# OPENROUTER_MODEL_LARGE=anthropic/claude-sonnet-5.5

# 1 = return canned JSON per call label (no key, no cost) to check UI states.
AI_MOCK=0

# Log every prompt sent to OpenRouter in the server console. Default: on outside production.
# 1 = force on, 0 = force off. Prompts may hold confidential text: keep off in shared deploys.
AI_LOG_PROMPTS=
